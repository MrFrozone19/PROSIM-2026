rules_version = '2';

// Galería: cada usuario solo puede leer, subir y borrar sus propios archivos, en gallery/{uid}/.
// Fotos JPEG de hasta 10 MB y videos de hasta 60 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{uid}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && (
          (request.resource.contentType == 'image/jpeg' && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size < 60 * 1024 * 1024)
        );
    }
  }
}
